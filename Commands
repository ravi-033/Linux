###FILE MANAGEMENT COMMANDS###
cd               #change directory
pwd              #Present working directory
history          #previous used commands
clear            #clear screen
ls               #list files and directories
ls -a            #list hidden files
ls -lasrth
ll  

touch <file_name>         #create file

mkdir <dir_name>          #create directory
mkdir -p /dir1/dir2/dir3  #multiple directory creation

rm <file_name>            #remove file
rm -f <file_name>         #forceful deletion
rmdir <dir_name>          #empty dir deletion
rm -rf <dir_name>         #recuressively removes files and directory

vi <file_name>            #create and open file
vim <file_name>
nano <file_name>

tar
zip
gzip

ln -s                   #soft symbolic link
ln -l                   #hard symbolic link

find /path_name -type f -name "*.log" -msize +500M -exec rm -rf {} \;
find /path_name -name "*.log" | xargs ls -larth
find . -name "*.txt" -mtime 1

wc -l
wc -n
wc -c

sed
awx
chmod
chown
chgrp
head
tail
more
less
cat
locate
awk
sudo -i #switch user

#filter output 
grep -i 'image' output.log
grep image output.log
grep -n 'image' output.log
grep -o "s" output.log



#copy 
cp -rp /host_path /destination_path           #copy within the same server
scp -rp /host_path /destination_path          #copy between 2 different servers
scp -rp /destination_path/file_name.txt .     #copying file from a different server to the present working directory (.)

#move
mv /host_path /destination_path


###STORAGE COMMANDS###
df -h               #disk free space check
du -sh .            #disk usage space check of present working directory (.)
du -sh /path_name   #disk space check for specific path (File/directory)
free -h             #memory and swap space check in human-readable format
free -m 
mkfs.ext4 /dev/sdb1        #create ext4 filesystem 
mount /dev/sdb1 /mnt/data  #mounting
umount /mnt/data           #umounting


###PROCESS MANAGEMENT COMMANDS###
top                  #cpu and memory info
htop                 #similar to top in a more graphical way 
ps aux               #list all processes
ps aux --sort=%mem,%cpu
ps -ef | grep "PID"
kill "PID"
kill -9 "PID"              #kill a process with PID (force kill)
pkill "Process_Name"       #kill a process with name
nproc                      #cpu processes 



